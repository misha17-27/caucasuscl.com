# ---------------------------------------------------------------
# Caucasus Customs and Logistics
# Ünvan sxemi orijinal caucasuscl.com ilə eynidir (bax includes/routes.php)
#   AZ  /  /haqqimizda/  /xidmetler/  /xidmetler/<slug>/  /gomruk-xeberleri/  /<xeber>/  /elaqe/
#   RU  /ru/  /ru/o-nas/  /ru/uslugi/  /ru/xidmetler/<slug>/  /ru/novosti/  /ru/kontakty/
#   EN  /en/  /en/about-us/  /en/services/  /en/services/<slug>/  /en/news/  /en/contact/
# ---------------------------------------------------------------

Options -Indexes
DirectoryIndex index.php

# Manifest düzgün tiplə verilməlidir, yoxsa brauzer onu oxumur
AddType application/manifest+json .webmanifest
AddType image/x-icon              .ico
AddType image/svg+xml             .svg

<IfModule mod_rewrite.c>
    RewriteEngine On
    # RewriteBase /            # alt qovluqda yerləşdirsəniz açın

    # Kanonik host: www -> www-suz. 12.11.2026-a qədər www.caucasuscl.com
    # bütün saytı 200 ilə verirdi və hər səhifənin canonical-ı öz hostuna
    # (www-ya) işarə edirdi — yəni sayt tam dublikat idi. Search Console
    # "Səhifələr" hesabatında www-lu ünvanlar indeksdə görünürdü.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # Çoxqat slash: //ru/o-nas/ -> /ru/o-nas/
    # 25.11.2026-da tapıldı. PHP-nin parse_url() funksiyası `//ru/o-nas/`
    # sətrini PROTOKOLSUZ ünvan kimi oxuyur: host `ru`, yol `/o-nas/`. Nəticədə
    # səhifə 200 verirdi, lakin dili itirirdi (rus ünvanı Azərbaycan mətni
    # göstərirdi) və canonical mövcud olmayan /o-nas/ ünvanını yazırdı.
    # `//xidmetler/<slug>/` isə canonical kimi 404 verən /<slug>/ göstərirdi.
    # PHP tərəfində də qoruma var (request_guard), bu birinci səddir.
    RewriteCond %{REQUEST_URI} ^//+(.*)$
    RewriteRule ^ /%1 [R=301,L]

    # İstifadə olunmayan HTTP metodları (XST və s.) bağlıdır
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|CONNECT|PUT|DELETE|PATCH)$ [NC]
    RewriteRule .* - [F,L]

    # Ünvanda açıq inyeksiya cəhdləri
    RewriteCond %{QUERY_STRING} (\.\./|<script|%3Cscript|base64_decode\(|union[\s+]+select) [NC]
    RewriteRule .* - [F,L]

    # Şablon, baza və məzmun qovluqları birbaşa açılmır (statik ötürmədən ƏVVƏL).
    # `content` — məqalələrin JSON mənbəyi; sayt onu bazadan oxuyur, veb-dən lazım deyil.
    RewriteRule ^(includes|storage|content|tools)(/|$) - [F,L]

    # Versiya nəzarəti və yerləşdirmə faylları. Repozitoriya public_html-dən
    # kənarda klonlanır, amma səhvən bura düşsə, `.git` bütün tarixçəni
    # (o cümlədən silinmiş sirrləri) verərdi.
    RewriteRule (^|/)\.(git|hg|svn|env)(/|$) - [F,L]
    RewriteRule ^\.cpanel\.yml$ - [F,L]

    # Arxiv və dump faylları. 06.11.2026-da public_html-də 39 MB-lıq
    # `admin.zip` tapıldı — adına görə panelin mənbəyi, yəni içində
    # `admin/config.php` (baza parolu, Turnstile və SMTP açarları) ola bilər.
    # Server onu 403 verirdi, lakin səbəb bizim qaydamız deyildi və izah
    # olunmayan qadağaya güvənmək olmaz.
    RewriteRule \.(zip|tar|gz|tgz|bz2|rar|7z|sql|sqlite|db|bak|old|swp|log)$ - [F,L,NC]

    # ---------- SİLİNMİŞ ÜNVANLAR: 410 ----------
    # DİQQƏT — SIRA MÜHÜMDÜR. Bu bloka aşağıdaki «mövcud fayl» ötürməsindən
    # ƏVVƏL baxılmalıdır. 25.11.2026-a qədər o, aşağıda idi və `[L]` onu
    # tamamilə susdurmuşdu: `/om-casino/` 410 verirdi, `/index.php/om-casino/`
    # isə 200 — yəni prefiksi dəyişdirməklə qumar spamı üçün sonsuz ünvan
    # fəzası açıq qalırdı (`/xeberler.php/casino/` də 200 verirdi). Qayda
    # mövcud faylın özünə toxunmur, çünki sayt kökündə bu açar sözlərlə
    # kəsişən fayl və qovluq yoxdur — yoxlanılıb.

    # köhnə WordPress-ə yerləşdirilmiş spam. Search Console-da «tapılmadı»
    # ünvanlarının böyük hissəsi bunlardır: qumar və idman mövzusunda vyetnam,
    # filippin və fransız dilində səhifələr. Sayt sındırılıb, həmin səhifələr
    # indekslənib. Onları YÖNLƏNDİRMƏK OLMAZ — yönləndirmə spam əlaqəsini real
    # səhifəyə ötürür. 410 verilir: Google onu 404-dən tez indeksdən çıxarır.
    RewriteRule ^(om|vwin|bk8|w88|fun88|188bet|lode88|lodi777|mwplay[0-9]*|ph444|tf88|nn777|wjslot|th777|hit-spin|phfun|mr-bet|help-slot)- - [G,L,NC]
    RewriteRule (slot|casino|poker|judi|togel|taruhan|bandar|nha-cai|dang-ky|dang-nhap|mien-phi|rut-tien|nap-tien) - [G,L,NC]
    # Təsadüfi adlı qapı (doorway) səhifələri. Yuxarıdakı açar sözlər bunları
    # tutmur, ona görə 404 verirdilər. Wayback CDX-ə görə hamısı 12.2025-də,
    # sındırma vaxtı indeksə düşüb və saytın öz məzmunu ilə əlaqəsi yoxdur.
    RewriteRule ^(9tsl331ru|b8ekidc7|ej9kznk15t|gofuo9jcv|o6qcttf9|oaueidf8)/?$ - [G,L]
    # WordPress-in texniki ünvanları — məzmun deyil, birbaşa «silinib».
    # `wp-content/uploads/` TOXUNULMUR: köhnə şəkil linkləri sınmasın.
    RewriteRule ^wp-json(/.*)?$                           - [G,L]
    RewriteRule ^wp-(admin|includes)(/.*)?$               - [G,L]
    RewriteRule ^wp-content/(themes|plugins|cache)(/.*)?$ - [G,L]

    # Mövcud fayl və qovluqlar (admin, assets) toxunulmaz
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Kanonik: sonda slash olsun (orijinal sayt kimi)
    RewriteCond %{REQUEST_URI} !^/$
    RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
    RewriteCond %{REQUEST_URI} !/$
    RewriteRule ^(.*)$ /$1/ [R=301,L]

    # ---------- WordPress-dən qalan ünvanlar ----------
    # Köhnə saytdan indeksdə qalan yüzlərlə ünvan var. Uyğun məzmun varsa
    # 301 veririk, yoxdursa 404/410 — hər ikisi Google üçün düzgün siqnaldır.

    # Sorğu parametrli köhnə ünvanlar (?p=12, ?cat=3, ?s=...) BURADA DEYİL.
    # Onlar PHP-də, request_guard() funksiyasında təmizlənir (includes/functions.php).
    # Səbəb: burada yazılmış qayda `^$` ilə yalnız kök ünvana baxırdı, kök isə
    # mövcud QOVLUQ olduğu üçün yuxarıdaki `-d` ötürməsi ona heç vaxt çatmağa
    # imkan vermirdi — `/?p=1` iki həftə 301 yerinə 200 verdi. Qaydanı yuxarı
    # qaldırmaq yerinə bir yerdə, PHP-də saxlamaq seçildi: .htaccess və
    # router.php arasında növbəti uyğunsuzluq yaranmasın.

    # Xəbər arxivinin səhifələnməsi: /gomruk-xeberleri/2/ və /page/2/
    RewriteRule ^(gomruk-xeberleri|xeberler)/(page/)?[0-9]+/?$  /gomruk-xeberleri/   [R=301,L]
    RewriteRule ^ru/(novosti|xeberler)/(page/)?[0-9]+/?$        /ru/novosti/         [R=301,L]
    RewriteRule ^en/(news|xeberler)/(page/)?[0-9]+/?$           /en/news/            [R=301,L]
    # `/page/2/` xəbər arxivinin ikinci səhifəsi idi, ana səhifə deyil.
    # 25.11.2026-a qədər burada `/` yazılmışdı, router.php-də isə xəbər
    # siyahısı — yəni iki fayl eyni ünvanı iki yerə göndərirdi.
    RewriteRule ^page/[0-9]+/?$                                 /gomruk-xeberleri/   [R=301,L]

    # ---------- RU/EN: köhnə arxiv ünvanları ----------
    # DİL İTMƏMƏLİDİR. 25.11.2026-a qədər aşağıdaki AZ qaydaları prefiksə
    # baxmırdı: `/ru/novosti/feed/` istifadəçini Azərbaycan siyahısına atırdı,
    # `/ru/tag/...`, `/en/category/...`, `/ru/author/...` və `/ru/page/2/` isə
    # ümumiyyətlə 404 verirdi. router.php bunların hamısını düzgün edirdi —
    # yəni səhv yalnız bu fayldaydı.
    RewriteRule ^ru/(.+/)?(feed|rss|rss2|atom)/?$        /ru/novosti/  [R=301,L]
    RewriteRule ^ru/(category|tag|etiket)(/.*)?$         /ru/novosti/  [R=301,L]
    RewriteRule ^ru/author(/.*)?$                        /ru/o-nas/    [R=301,L]
    RewriteRule ^ru/page/[0-9]+/?$                       /ru/novosti/  [R=301,L]

    RewriteRule ^en/(.+/)?(feed|rss|rss2|atom)/?$        /en/news/     [R=301,L]
    RewriteRule ^en/(category|tag|etiket)(/.*)?$         /en/news/     [R=301,L]
    RewriteRule ^en/author(/.*)?$                        /en/about-us/ [R=301,L]
    RewriteRule ^en/page/[0-9]+/?$                       /en/news/     [R=301,L]

    # ---------- AZ: köhnə arxiv ünvanları ----------
    RewriteRule ^(.+/)?feed/?$               /gomruk-xeberleri/ [R=301,L]
    RewriteRule ^(rss|rss2|atom)/?$          /gomruk-xeberleri/ [R=301,L]
    RewriteRule ^(category|tag|etiket)(/.*)?$ /gomruk-xeberleri/ [R=301,L]
    RewriteRule ^author(/.*)?$               /haqqimizda/       [R=301,L]

    # ---------- sitemap ----------
    RewriteRule ^sitemap\.xml$                   sitemap.php           [L]
    RewriteRule ^sitemap_index\.xml$             sitemap.php?index=1   [L]
    # Yoast-ın alt-sitemap ünvanları -> əsas sitemap
    RewriteRule ^[a-z_-]+-sitemap[0-9]*\.xml$    /sitemap.xml [R=301,L]

    # ---------- köhnə ünvanlar -> yeni sxem (router.php ilə eyni) ----------
    # Köhnə saytda bu xəbərin slug-ı tam başlıq idi (147 simvol). İmport
    # zamanı qısaldılıb, amma yönləndirmə qoyulmayıb — ünvan 404 verirdi.
    # Məzmun eynidir: hədəf səhifənin H1-i həmin başlıqdır.
    RewriteRule ^(ru/novosti/|en/news/)?idxal-olunan-mallara-munasibetde-gomruk-rusumlarinin-ve-yigilmasi-gomruk-orqanlarina-hevale-edilmis-vergilerin-hesablanmasi-zamani-hansi-vaxt-esas-goturulur/?$ /$1gomruk-rusumlari-hesablanmasi/ [R=301,L]

    # `category/xeberler` ayrıca yazılmırdı — yuxarıdaki geniş `category|tag`
    # qaydaları onu hər üç dildə tutur.
    RewriteRule ^xeberler/?$                     /gomruk-xeberleri/ [R=301,L]
    RewriteRule ^linkler/?$                      /faydali-linkler/  [R=301,L]
    RewriteRule ^xeberler/([a-z0-9-]+)/?$        /$1/               [R=301,L]

    RewriteRule ^ru/xeberler/?$                  /ru/novosti/          [R=301,L]
    RewriteRule ^ru/linkler/?$                   /ru/poleznye-ssylki/  [R=301,L]
    RewriteRule ^ru/xeberler/([a-z0-9-]+)/?$     /ru/novosti/$1/       [R=301,L]

    RewriteRule ^en/xeberler/?$                  /en/news/         [R=301,L]
    RewriteRule ^en/linkler/?$                   /en/useful-links/ [R=301,L]
    RewriteRule ^en/xeberler/([a-z0-9-]+)/?$     /en/news/$1/      [R=301,L]

    # ---------- marşrutlar ----------
    # `[QSA]` QƏSDƏN YOXDUR. 25.11.2026-da tapıldı: QSA ziyarətçinin sorğu
    # sətrini bizim yazdığımızın ARXASINA əlavə edir, PHP isə təkrarlanan
    # parametrdən SONUNCUnu götürür. Yəni `?slug=...` ünvanda yazılan dəyər
    # bizimkini üstələyirdi: `/ozunet-elektron-gomruk-xidmetleri/?slug=incoterms-2020-sertleri`
    # Incoterms məqaləsinin bütün mətnini verirdi, canonical isə ÖZGƏ ünvanı
    # göstərirdi — yəni hər məqalə hər hansı başqa ünvan altında açıla bilirdi.
    # Saytın heç bir açıq səhifəsi `slug`-dan başqa GET parametri oxumur
    # (yoxlanılıb), ona görə QSA-ya ehtiyac yoxdur.

    # ---------- EN ----------
    RewriteRule ^en/?$                           index.php       [L]
    RewriteRule ^en/about-us/?$                  haqqimizda.php  [L]
    RewriteRule ^en/services/?$                  xidmetler.php   [L]
    RewriteRule ^en/services/([a-z0-9-]+)/?$     xidmet.php?slug=$1 [L]
    RewriteRule ^en/news/?$                      xeberler.php    [L]
    RewriteRule ^en/news/([a-z0-9-]+)/?$         xeber.php?slug=$1  [L]
    RewriteRule ^en/contact/?$                   elaqe.php       [L]
    RewriteRule ^en/useful-links/?$              linkler.php     [L]

    # ---------- RU ----------
    RewriteRule ^ru/?$                           index.php       [L]
    RewriteRule ^ru/o-nas/?$                     haqqimizda.php  [L]
    RewriteRule ^ru/uslugi/?$                    xidmetler.php   [L]
    RewriteRule ^ru/xidmetler/([a-z0-9-]+)/?$    xidmet.php?slug=$1 [L]
    RewriteRule ^ru/novosti/?$                   xeberler.php    [L]
    RewriteRule ^ru/novosti/([a-z0-9-]+)/?$      xeber.php?slug=$1  [L]
    RewriteRule ^ru/kontakty/?$                  elaqe.php       [L]
    RewriteRule ^ru/poleznye-ssylki/?$           linkler.php     [L]

    # ---------- AZ ----------
    RewriteRule ^haqqimizda/?$                   haqqimizda.php  [L]
    RewriteRule ^xidmetler/?$                    xidmetler.php   [L]
    RewriteRule ^xidmetler/([a-z0-9-]+)/?$       xidmet.php?slug=$1 [L]
    RewriteRule ^gomruk-xeberleri/?$             xeberler.php    [L]
    RewriteRule ^elaqe/?$                        elaqe.php       [L]
    RewriteRule ^faydali-linkler/?$              linkler.php     [L]

    # AZ xəbərləri kökdə — ən sonda, qalan hər şeyi tutur
    RewriteRule ^([a-z0-9-]{6,})/?$              xeber.php?slug=$1 [L]
</IfModule>

ErrorDocument 404 /404.php

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg             "access plus 6 months"
    ExpiresByType image/png              "access plus 6 months"
    ExpiresByType image/svg+xml          "access plus 6 months"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Baza, log, məlumat və ehtiyat nüsxə faylları bağlıdır
<FilesMatch "\.(log|sqlite|sqlite-wal|sqlite-shm|bak|bak2|json|sql|zip|md)$">
    Require all denied
</FilesMatch>

# Gizli fayllar (.git, .env, .htaccess...)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ---------------------------------------------------------------
# TƏHLÜKƏSİZLİK BAŞLIQLARI
# ---------------------------------------------------------------
<IfModule mod_headers.c>
    # MIME növünün təxmin edilməsi bağlıdır
    Header always set X-Content-Type-Options "nosniff"
    # Saytın başqa domendə çərçivəyə salınması (clickjacking) bağlıdır
    Header always set X-Frame-Options "SAMEORIGIN"
    # Referer yalnız eyni mənşəyə tam gedir
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # İstifadə olunmayan brauzer imkanları söndürülür
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set X-Permitted-Cross-Domain-Policies "none"

    # Content-Security-Policy
    #   script-src: yalnız öz faylarımız + Turnstile ('unsafe-inline' YOXDUR)
    #   style-src : inline style="..." atributları işlədilir, ona görə 'unsafe-inline'
    #   frame-src : YouTube (xəbər videoları), Google Maps (əlaqə), Turnstile
    #   static.cloudflareinsights.com — Cloudflare-in statistika beacon-u
    #   googletagmanager.com + google-analytics.com — Google Analytics 4
    #   'unsafe-eval' — Turnstile-in yoxlama mühərriki eval işlədir; onsuz
    #   kapça ümumiyyətlə görünmür. Skript mənbələri yalnız etibarlı
    #   domenlərdir və script-src-də 'unsafe-inline' YOXDUR.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-eval' https://challenges.cloudflare.com https://static.cloudflareinsights.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://static.cloudflareinsights.com https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com; frame-src https://challenges.cloudflare.com https://www.youtube.com https://www.youtube-nocookie.com https://www.google.com https://maps.google.com; worker-src 'self' blob:; connect-src 'self' https://challenges.cloudflare.com https://cloudflareinsights.com https://static.cloudflareinsights.com https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://stats.g.doubleclick.net; upgrade-insecure-requests"

    # Server və PHP versiyası bildirilməsin
    Header always unset X-Powered-By
    Header always unset X-Turbo-Charged-By
    Header unset X-Powered-By
</IfModule>

# PHP versiyasının başlıqda görünməməsi
<IfModule mod_php.c>
    php_flag expose_php off
</IfModule>

